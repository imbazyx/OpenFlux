<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's own cache directory. The provider is not exported; access is
  granted per-URI and for a single install session.

  This grants the whole cacheDir, not just the update APK, because
  installUpdate writes update-<version>.apk directly into cacheDir and the
  grant has to cover that exact file. Narrowing it would mean moving the
  download into a subdirectory and pointing path= at it - do both at once or
  the install fails at runtime with no build-time warning.
-->
<paths>
    <cache-path
        name="updates"
        path="." />
</paths>
