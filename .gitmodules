# The submodules below are deliberately NOT the originals' repositories. This
# fork carries its own commits inside both of them - OpenFlux 5e714cd (the
# logcat flood fix and the batched-writer restart fix) and shared ba86d07 -
# and those commits exist nowhere else. Pointing these at p1neappleXpress/*
# would make `git clone --recurse-submodules` fail to resolve them and abort,
# so the published fork would not even contain the work it advertises.
#
# BEFORE THE FIRST PUSH: both repositories below must exist under imbazyx and
# contain the pinned commits, or nobody can clone this. See
# docs/PUBLISH-CHECKLIST.md.
[submodule "OpenFlux"]
	path = OpenFlux
	url = https://github.com/imbazyx/OpenFlux.git
[submodule "shared"]
	path = shared
	url = https://github.com/imbazyx/OpenFluxClientShared.git
